# Copia este archivo como ".env" (en esta misma carpeta) y llena los valores.
# El archivo .env NUNCA se sube a git.

# ---- TURN de Cloudflare (opcional) ----
# Respaldo para cuando la conexión directa de video falla (otro país, datos móviles...).
# Sin estos valores la app funciona igual, pero solo con conexión directa.
# Se obtienen en el panel de Cloudflare, en la sección de Realtime / TURN Server,
# creando una "TURN key": te da un Key ID y un API Token.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ---- SFU de Cloudflare (opcional) ----
# Servidor intermedio de video: el anfitrión manda UNA copia y Cloudflare la reparte
# a cada espectador (mejor calidad y fluidez, sobre todo entre países).
# Sin estos valores la app funciona igual, con conexión directa (P2P).
# Se obtienen en el panel de Cloudflare, en Realtime / SFU, con "Create application":
# te da un App ID y un App Secret (API token). El secreto NUNCA sale del servidor.
CLOUDFLARE_SFU_APP_ID=
CLOUDFLARE_SFU_APP_SECRET=
